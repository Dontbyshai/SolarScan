{
  "name": "solar-scanner",
  "version": "1.5.0",
  "description": "Détecteur de panneaux solaires par imagerie satellite IGN",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac:all": "electron-builder --mac --arm64 --x64 --publish never"
  },
  "build": {
    "appId": "fr.solarscanner.app",
    "productName": "Solar Scanner",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "../assets/logo.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "background": "../assets/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": "nsis",
      "icon": "../assets/logo.png"
    },
    "nsis": {
      "installerSidebar": "../assets/installer-sidebar.bmp",
      "uninstallerSidebar": "../assets/installer-sidebar.bmp"
    },
    "files": [
      "**/*",
      "../frontend/**/*",
      "../assets/**/*",
      "!scripts",
      "!scripts/**",
      "!entitlements.mac.plist"
    ],
    "extraResources": [
      {
        "from": "../assets",
        "to": "assets"
      },
      {
        "from": "../backend/dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterSign": "scripts/notarize.js"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "author": "Solar Scanner",
  "license": "MIT"
}
